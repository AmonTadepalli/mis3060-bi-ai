// HW6 Part B: returns one row per (measure, slice). Run in DAX query view, Copy the result grid,
// paste into reports/powerbi_values.csv (tab- or comma-separated both work). Values are unrounded text.
EVALUATE
UNION (
    ROW ( "measure", "AUM (naive SUM)", "slice", "Total", "value", "" & CALCULATE ( [AUM (naive SUM)] ) ),
    ROW ( "measure", "Ending AUM", "slice", "Total", "value", "" & CALCULATE ( [Ending AUM] ) ),
    ROW ( "measure", "Ending Clients", "slice", "Total", "value", "" & CALCULATE ( [Ending Clients] ) ),
